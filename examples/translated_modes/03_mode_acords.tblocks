{
  "name": "Mode Acords Aleatoris",
  "version": "1.0",
  "format": "legacy",
  "blocks": "<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <block type=\"tecla_repeat_forever\" x=\"50\" y=\"50\">\n    <statement name=\"DO\">\n      <block type=\"variables_set\">\n         <field name=\"VAR\">chord_type</field>\n         <value name=\"VALUE\">\n            <block type=\"tecla_math_random_int\">\n                <value name=\"FROM\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n                <value name=\"TO\"><shadow type=\"math_number\"><field name=\"NUM\">3</field></shadow></value>\n            </block>\n         </value>\n         <next>\n             <block type=\"controls_if\">\n                 <mutation else=\"1\"></mutation>\n                 <value name=\"IF0\">\n                    <block type=\"logic_compare\">\n                        <field name=\"OP\">EQ</field>\n                        <value name=\"A\"><block type=\"variables_get\"><field name=\"VAR\">chord_type</field></block></value>\n                        <value name=\"B\"><block type=\"math_number\"><field name=\"NUM\">0</field></block></value>\n                    </block>\n                 </value>\n                 <statement name=\"DO0\">\n                    <block type=\"tecla_play_chord\">\n                        <field name=\"CHORD\">C</field>\n                        <field name=\"DURATION\">1</field>\n                    </block>\n                 </statement>\n                 <statement name=\"ELSE\">\n                     <block type=\"controls_if\">\n                         <mutation else=\"1\"></mutation>\n                         <value name=\"IF0\">\n                            <block type=\"logic_compare\">\n                                <field name=\"OP\">EQ</field>\n                                <value name=\"A\"><block type=\"variables_get\"><field name=\"VAR\">chord_type</field></block></value>\n                                <value name=\"B\"><block type=\"math_number\"><field name=\"NUM\">1</field></block></value>\n                            </block>\n                         </value>\n                         <statement name=\"DO0\">\n                            <block type=\"tecla_play_chord\">\n                                <field name=\"CHORD\">Am</field>\n                                <field name=\"DURATION\">1</field>\n                            </block>\n                         </statement>\n                         <statement name=\"ELSE\">\n                            <block type=\"controls_if\">\n                                 <mutation else=\"1\"></mutation>\n                                 <value name=\"IF0\">\n                                    <block type=\"logic_compare\">\n                                        <field name=\"OP\">EQ</field>\n                                        <value name=\"A\"><block type=\"variables_get\"><field name=\"VAR\">chord_type</field></block></value>\n                                        <value name=\"B\"><block type=\"math_number\"><field name=\"NUM\">2</field></block></value>\n                                    </block>\n                                 </value>\n                                 <statement name=\"DO0\">\n                                    <block type=\"tecla_play_chord\">\n                                        <field name=\"CHORD\">F</field>\n                                        <field name=\"DURATION\">1</field>\n                                    </block>\n                                 </statement>\n                                 <statement name=\"ELSE\">\n                                    <block type=\"tecla_play_chord\">\n                                        <field name=\"CHORD\">G</field>\n                                        <field name=\"DURATION\">1</field>\n                                    </block>\n                                 </statement>\n                            </block>\n                         </statement>\n                     </block>\n                 </statement>\n             </block>\n         </next>\n      </block>\n    </statement>\n  </block>\n</xml>"
}
