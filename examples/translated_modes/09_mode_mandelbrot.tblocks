{
  "name": "Mode Mandelbrot",
  "version": "1.0",
  "format": "legacy",
  "blocks": "<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <block type=\"tecla_repeat_forever\" x=\"50\" y=\"50\">\n    <statement name=\"DO\">\n      <block type=\"variables_set\">\n        <field name=\"VAR\">cx</field>\n        <value name=\"VALUE\">\n           <block type=\"tecla_math_map\">\n              <value name=\"VALUE\"><block type=\"tecla_read_pot\"><field name=\"POT\">0</field></block></value>\n              <value name=\"FROM_MIN\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n              <value name=\"FROM_MAX\"><shadow type=\"math_number\"><field name=\"NUM\">127</field></shadow></value>\n              <value name=\"TO_MIN\"><shadow type=\"math_number\"><field name=\"NUM\">-2.5</field></shadow></value>\n              <value name=\"TO_MAX\"><shadow type=\"math_number\"><field name=\"NUM\">1.0</field></shadow></value>\n           </block>\n        </value>\n        <next>\n           <block type=\"variables_set\">\n             <field name=\"VAR\">cy</field>\n             <value name=\"VALUE\">\n                <block type=\"tecla_math_map\">\n                   <value name=\"VALUE\"><block type=\"tecla_read_pot\"><field name=\"POT\">1</field></block></value>\n                   <value name=\"FROM_MIN\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n                   <value name=\"FROM_MAX\"><shadow type=\"math_number\"><field name=\"NUM\">127</field></shadow></value>\n                   <value name=\"TO_MIN\"><shadow type=\"math_number\"><field name=\"NUM\">-1.0</field></shadow></value>\n                   <value name=\"TO_MAX\"><shadow type=\"math_number\"><field name=\"NUM\">1.0</field></shadow></value>\n                </block>\n             </value>\n             <next>\n                <!-- Simplified Mandelbrot check iterating a few times -->\n                <block type=\"variables_set\">\n                    <field name=\"VAR\">zr</field><value name=\"VALUE\"><block type=\"math_number\"><field name=\"NUM\">0</field></block></value>\n                    <next>\n                        <block type=\"variables_set\">\n                            <field name=\"VAR\">zi</field><value name=\"VALUE\"><block type=\"math_number\"><field name=\"NUM\">0</field></block></value>\n                            <next>\n                                <block type=\"variables_set\">\n                                    <field name=\"VAR\">iter</field>\n                                    <value name=\"VALUE\"><block type=\"math_number\"><field name=\"NUM\">0</field></block></value>\n                                    <next>\n                                        <block type=\"controls_repeat_ext\">\n                                            <value name=\"TIMES\"><shadow type=\"math_number\"><field name=\"NUM\">10</field></shadow></value>\n                                            <statement name=\"DO\">\n                                                <block type=\"variables_set\">\n                                                    <field name=\"VAR\">zr_new</field>\n                                                    <value name=\"VALUE\">\n                                                        <block type=\"math_arithmetic\">\n                                                            <field name=\"OP\">ADD</field>\n                                                            <value name=\"A\">\n                                                                <block type=\"math_arithmetic\">\n                                                                    <field name=\"OP\">MINUS</field>\n                                                                    <value name=\"A\"><block type=\"math_arithmetic\"><field name=\"OP\">MULTIPLY</field><value name=\"A\"><block type=\"variables_get\"><field name=\"VAR\">zr</field></block></value><value name=\"B\"><block type=\"variables_get\"><field name=\"VAR\">zr</field></block></value></block></value>\n                                                                    <value name=\"B\"><block type=\"math_arithmetic\"><field name=\"OP\">MULTIPLY</field><value name=\"A\"><block type=\"variables_get\"><field name=\"VAR\">zi</field></block></value><value name=\"B\"><block type=\"variables_get\"><field name=\"VAR\">zi</field></block></value></block></value>\n                                                                </block>\n                                                            </value>\n                                                            <value name=\"B\"><block type=\"variables_get\"><field name=\"VAR\">cx</field></block></value>\n                                                        </block>\n                                                    </value>\n                                                    <next>\n                                                        <block type=\"variables_set\">\n                                                            <field name=\"VAR\">zi</field>\n                                                            <value name=\"VALUE\">\n                                                                <block type=\"math_arithmetic\">\n                                                                    <field name=\"OP\">ADD</field>\n                                                                    <value name=\"A\">\n                                                                        <block type=\"math_arithmetic\">\n                                                                            <field name=\"OP\">MULTIPLY</field>\n                                                                            <value name=\"A\"><block type=\"math_number\"><field name=\"NUM\">2</field></block></value>\n                                                                            <value name=\"B\"><block type=\"math_arithmetic\"><field name=\"OP\">MULTIPLY</field><value name=\"A\"><block type=\"variables_get\"><field name=\"VAR\">zr</field></block></value><value name=\"B\"><block type=\"variables_get\"><field name=\"VAR\">zi</field></block></value></block></value>\n                                                                        </block>\n                                                                    </value>\n                                                                    <value name=\"B\"><block type=\"variables_get\"><field name=\"VAR\">cy</field></block></value>\n                                                                </block>\n                                                            </value>\n                                                            <next>\n                                                                <block type=\"variables_set\">\n                                                                    <field name=\"VAR\">zr</field>\n                                                                    <value name=\"VALUE\"><block type=\"variables_get\"><field name=\"VAR\">zr_new</field></block></value>\n                                                                    <next>\n                                                                       <!-- Increment only if magnitude < 2 (bounded) logic is tricky in blocks, just iterating -->\n                                                                       <block type=\"variables_set\">\n                                                                          <field name=\"VAR\">iter</field>\n                                                                          <value name=\"VALUE\">\n                                                                            <block type=\"math_arithmetic\">\n                                                                                <field name=\"OP\">ADD</field>\n                                                                                <value name=\"A\"><block type=\"variables_get\"><field name=\"VAR\">iter</field></block></value>\n                                                                                <value name=\"B\"><block type=\"math_number\"><field name=\"NUM\">1</field></block></value>\n                                                                            </block>\n                                                                          </value>\n                                                                       </block>\n                                                                    </next>\n                                                                </block>\n                                                            </next>\n                                                        </block>\n                                                    </next>\n                                                </block>\n                                            </statement>\n                                            <next>\n                                                <!-- Play Note based on result -->\n                                                <block type=\"tecla_play_note\">\n                                                    <value name=\"NOTE\">\n                                                        <block type=\"tecla_math_map\">\n                                                            <value name=\"VALUE\">\n                                                                <block type=\"math_arithmetic\">\n                                                                    <field name=\"OP\">ADD</field>\n                                                                    <value name=\"A\"><block type=\"math_arithmetic\"><field name=\"OP\">MULTIPLY</field><value name=\"A\"><block type=\"variables_get\"><field name=\"VAR\">zr</field></block></value><value name=\"B\"><block type=\"variables_get\"><field name=\"VAR\">zr</field></block></value></block></value>\n                                                                    <value name=\"B\"><block type=\"math_arithmetic\"><field name=\"OP\">MULTIPLY</field><value name=\"A\"><block type=\"variables_get\"><field name=\"VAR\">zi</field></block></value><value name=\"B\"><block type=\"variables_get\"><field name=\"VAR\">zi</field></block></value></block></value>\n                                                                </block>\n                                                            </value>\n                                                            <value name=\"FROM_MIN\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n                                                            <value name=\"FROM_MAX\"><shadow type=\"math_number\"><field name=\"NUM\">4</field></shadow></value>\n                                                            <value name=\"TO_MIN\"><shadow type=\"math_number\"><field name=\"NUM\">36</field></shadow></value>\n                                                            <value name=\"TO_MAX\"><shadow type=\"math_number\"><field name=\"NUM\">96</field></shadow></value>\n                                                        </block>\n                                                    </value>\n                                                    <value name=\"VELOCITY\"><shadow type=\"math_number\"><field name=\"NUM\">100</field></shadow></value>\n                                                    <value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">0.1</field></shadow></value>\n                                                </block>\n                                            </next>\n                                        </block>\n                                    </next>\n                                </block>\n                            </next>\n                        </block>\n                    </next>\n                </block>\n             </next>\n           </block>\n        </next>\n      </block>\n    </statement>\n  </block>\n</xml>"
}
