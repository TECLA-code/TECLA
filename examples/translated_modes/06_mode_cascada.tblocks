{
  "name": "Mode Cascada",
  "version": "1.0",
  "format": "legacy",
  "blocks": "<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <block type=\"tecla_repeat_forever\" x=\"50\" y=\"50\">\n    <statement name=\"DO\">\n      <block type=\"variables_set\">\n         <field name=\"VAR\">intensity</field>\n         <value name=\"VALUE\">\n            <block type=\"tecla_read_pot\">\n                <field name=\"POT\">0</field>\n            </block>\n         </value>\n         <next>\n            <block type=\"tecla_oscillator\">\n                <field name=\"WAVEFORM\">NOISE</field>\n                <value name=\"FREQUENCY\">\n                    <block type=\"tecla_read_pot\">\n                        <field name=\"POT\">1</field>\n                    </block>\n                </value>\n                <value name=\"AMPLITUDE\">\n                    <block type=\"variables_get\">\n                        <field name=\"VAR\">intensity</field>\n                    </block>\n                </value>\n                <next>\n                    <block type=\"controls_if\">\n                        <value name=\"IF0\">\n                            <block type=\"tecla_probability\">\n                                <value name=\"PERCENT\">\n                                    <block type=\"tecla_math_map\">\n                                        <value name=\"VALUE\"><block type=\"variables_get\"><field name=\"VAR\">intensity</field></block></value>\n                                        <value name=\"FROM_MIN\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n                                        <value name=\"FROM_MAX\"><shadow type=\"math_number\"><field name=\"NUM\">127</field></shadow></value>\n                                        <value name=\"TO_MIN\"><shadow type=\"math_number\"><field name=\"NUM\">5</field></shadow></value>\n                                        <value name=\"TO_MAX\"><shadow type=\"math_number\"><field name=\"NUM\">50</field></shadow></value>\n                                    </block>\n                                </value>\n                            </block>\n                        </value>\n                        <statement name=\"DO0\">\n                            <!-- Random Impacts (Water splashes) -->\n                            <block type=\"tecla_play_note\">\n                                <value name=\"NOTE\">\n                                    <block type=\"tecla_math_random_int\">\n                                        <value name=\"FROM\"><shadow type=\"math_number\"><field name=\"NUM\">80</field></shadow></value>\n                                        <value name=\"TO\"><shadow type=\"math_number\"><field name=\"NUM\">100</field></shadow></value>\n                                    </block>\n                                </value>\n                                <value name=\"VELOCITY\"><block type=\"variables_get\"><field name=\"VAR\">intensity</field></block></value>\n                                <value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">0.05</field></shadow></value>\n                            </block>\n                        </statement>\n                        <next>\n                            <block type=\"tecla_wait\">\n                                <value name=\"TIME\"><shadow type=\"math_number\"><field name=\"NUM\">0.1</field></shadow></value>\n                            </block>\n                        </next>\n                    </block>\n                </next>\n            </block>\n         </next>\n      </block>\n    </statement>\n  </block>\n</xml>"
}
