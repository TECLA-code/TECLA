{
  "name": "Mode Ritmes Euclidians",
  "version": "1.0",
  "format": "legacy",
  "blocks": "<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <block type=\"tecla_repeat_forever\" x=\"50\" y=\"50\">\n    <statement name=\"DO\">\n      <block type=\"variables_set\">\n        <field name=\"VAR\">pulses</field>\n        <value name=\"VALUE\">\n          <block type=\"tecla_math_map\">\n             <value name=\"VALUE\"><block type=\"tecla_read_pot\"><field name=\"POT\">1</field></block></value>\n             <value name=\"FROM_MIN\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n             <value name=\"FROM_MAX\"><shadow type=\"math_number\"><field name=\"NUM\">127</field></shadow></value>\n             <value name=\"TO_MIN\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow></value>\n             <value name=\"TO_MAX\"><shadow type=\"math_number\"><field name=\"NUM\">16</field></shadow></value>\n          </block>\n        </value>\n        <next>\n            <block type=\"variables_set\">\n                <field name=\"VAR\">steps</field>\n                <value name=\"VALUE\">\n                  <block type=\"tecla_math_map\">\n                     <value name=\"VALUE\"><block type=\"tecla_read_pot\"><field name=\"POT\">2</field></block></value>\n                     <value name=\"FROM_MIN\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n                     <value name=\"FROM_MAX\"><shadow type=\"math_number\"><field name=\"NUM\">127</field></shadow></value>\n                     <value name=\"TO_MIN\"><shadow type=\"math_number\"><field name=\"NUM\">4</field></shadow></value>\n                     <value name=\"TO_MAX\"><shadow type=\"math_number\"><field name=\"NUM\">16</field></shadow></value>\n                  </block>\n                </value>\n                <next>\n                    <block type=\"controls_if\">\n                        <mutation else=\"1\"></mutation>\n                        <value name=\"IF0\">\n                            <block type=\"tecla_euclidean_rhythm\">\n                                <value name=\"STEP\"><block type=\"variables_get\"><field name=\"VAR\">step_counter</field></block></value>\n                                <value name=\"PULSES\"><block type=\"variables_get\"><field name=\"VAR\">pulses</field></block></value>\n                                <value name=\"STEPS\"><block type=\"variables_get\"><field name=\"VAR\">steps</field></block></value>\n                            </block>\n                        </value>\n                        <statement name=\"DO0\">\n                            <block type=\"tecla_play_note\">\n                                <value name=\"NOTE\">\n                                    <block type=\"tecla_math_random_int\">\n                                        <value name=\"FROM\"><shadow type=\"math_number\"><field name=\"NUM\">60</field></shadow></value>\n                                        <value name=\"TO\"><shadow type=\"math_number\"><field name=\"NUM\">72</field></shadow></value>\n                                    </block>\n                                </value>\n                                <value name=\"VELOCITY\"><shadow type=\"math_number\"><field name=\"NUM\">100</field></shadow></value>\n                                <value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">0.1</field></shadow></value>\n                            </block>\n                        </statement>\n                        <next>\n                            <block type=\"variables_set\">\n                                <field name=\"VAR\">step_counter</field>\n                                <value name=\"VALUE\">\n                                    <block type=\"math_arithmetic\">\n                                        <field name=\"OP\">ADD</field>\n                                        <value name=\"A\"><block type=\"variables_get\"><field name=\"VAR\">step_counter</field></block></value>\n                                        <value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow></value>\n                                    </block>\n                                </value>\n                                <next>\n                                    <block type=\"tecla_wait\">\n                                        <value name=\"TIME\">\n                                            <block type=\"tecla_math_map\">\n                                                <value name=\"VALUE\"><block type=\"tecla_read_pot\"><field name=\"POT\">0</field></block></value>\n                                                <value name=\"FROM_MIN\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n                                                <value name=\"FROM_MAX\"><shadow type=\"math_number\"><field name=\"NUM\">127</field></shadow></value>\n                                                <value name=\"TO_MIN\"><shadow type=\"math_number\"><field name=\"NUM\">0.05</field></shadow></value>\n                                                <value name=\"TO_MAX\"><shadow type=\"math_number\"><field name=\"NUM\">0.5</field></shadow></value>\n                                            </block>\n                                        </value>\n                                    </block>\n                                </next>\n                            </block>\n                        </next>\n                    </block>\n                </next>\n            </block>\n        </next>\n      </block>\n    </statement>\n  </block>\n</xml>"
}
