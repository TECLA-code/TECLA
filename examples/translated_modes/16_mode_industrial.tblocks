{
  "name": "Mode Industrial (Auto)",
  "version": "1.0",
  "format": "legacy",
  "blocks": "<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <block type=\"tecla_repeat_forever\" x=\"50\" y=\"50\">\n    <statement name=\"DO\">\n      <block type=\"variables_set\">\n        <field name=\"VAR\">machine_bpm</field>\n        <value name=\"VALUE\">\n           <!-- Machine Speed: LFO 60-240 BPM -->\n           <block type=\"tecla_software_lfo\">\n               <value name=\"RATE\"><shadow type=\"math_number\"><field name=\"NUM\">0.2</field></shadow></value>\n               <value name=\"MIN\"><shadow type=\"math_number\"><field name=\"NUM\">60</field></shadow></value>\n               <value name=\"MAX\"><shadow type=\"math_number\"><field name=\"NUM\">240</field></shadow></value>\n           </block>\n        </value>\n        <next>\n           <block type=\"variables_set\">\n             <field name=\"VAR\">steam_pressure</field>\n             <value name=\"VALUE\">\n                <!-- Steam Pressure: Slow LFO 0-100 -->\n                <block type=\"tecla_software_lfo\">\n                    <value name=\"RATE\"><shadow type=\"math_number\"><field name=\"NUM\">0.15</field></shadow></value>\n                    <value name=\"MIN\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n                    <value name=\"MAX\"><shadow type=\"math_number\"><field name=\"NUM\">100</field></shadow></value>\n                </block>\n             </value>\n             <next>\n                <block type=\"variables_set\">\n                  <field name=\"VAR\">num_gears</field>\n                  <value name=\"VALUE\">\n                     <!-- Complexity/Gears: Very Slow LFO 1-8 -->\n                     <block type=\"tecla_software_lfo\">\n                         <value name=\"RATE\"><shadow type=\"math_number\"><field name=\"NUM\">0.08</field></shadow></value>\n                         <value name=\"MIN\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow></value>\n                         <value name=\"MAX\"><shadow type=\"math_number\"><field name=\"NUM\">8</field></shadow></value>\n                     </block>\n                  </value>\n                  <next>\n                     <!-- Main Machine Beat (Strong on 4s) -->\n                     <block type=\"tecla_play_note\">\n                         <value name=\"NOTE\"><shadow type=\"math_number\"><field name=\"NUM\">36</field></shadow></value>\n                         <value name=\"VELOCITY\"><shadow type=\"math_number\"><field name=\"NUM\">100</field></shadow></value>\n                         <value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">0.1</field></shadow></value>\n                         <next>\n                            <!-- Secondary Beat -->\n                            <block type=\"tecla_play_note\">\n                                <value name=\"NOTE\"><shadow type=\"math_number\"><field name=\"NUM\">40</field></shadow></value>\n                                <value name=\"VELOCITY\"><shadow type=\"math_number\"><field name=\"NUM\">80</field></shadow></value>\n                                <value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">0.1</field></shadow></value>\n                                <next>\n                                   <!-- Mechanical Tick -->\n                                   <block type=\"tecla_play_note\">\n                                       <value name=\"NOTE\"><shadow type=\"math_number\"><field name=\"NUM\">48</field></shadow></value>\n                                       <value name=\"VELOCITY\"><shadow type=\"math_number\"><field name=\"NUM\">60</field></shadow></value>\n                                       <value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">0.05</field></shadow></value>\n                                       <next>\n                                          <!-- Gears Pattern (varies with complexity) -->\n                                          <block type=\"controls_repeat_ext\">\n                                              <value name=\"TIMES\"><block type=\"variables_get\"><field name=\"VAR\">num_gears</field></block></value>\n                                              <statement name=\"DO\">\n                                                  <block type=\"tecla_play_note\">\n                                                      <value name=\"NOTE\">\n                                                          <block type=\"math_random_int\">\n                                                              <value name=\"FROM\"><shadow type=\"math_number\"><field name=\"NUM\">52</field></shadow></value>\n                                                              <value name=\"TO\"><shadow type=\"math_number\"><field name=\"NUM\">76</field></shadow></value>\n                                                          </block>\n                                                      </value>\n                                                      <value name=\"VELOCITY\"><shadow type=\"math_number\"><field name=\"NUM\">70</field></shadow></value>\n                                                      <value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">0.05</field></shadow></value>\n                                                      <next>\n                                                          <block type=\"tecla_wait\">\n                                                              <value name=\"TIME\"><shadow type=\"math_number\"><field name=\"NUM\">0.03</field></shadow></value>\n                                                          </block>\n                                                      </next>\n                                                  </block>\n                                              </statement>\n                                              <next>\n                                                  <!-- Steam Whistle (when pressure > 50) -->\n                                                  <block type=\"controls_if\">\n                                                      <value name=\"IF0\">\n                                                          <block type=\"logic_compare\">\n                                                              <field name=\"OP\">GT</field>\n                                                              <value name=\"A\"><block type=\"variables_get\"><field name=\"VAR\">steam_pressure</field></block></value>\n                                                              <value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">50</field></shadow></value>\n                                                          </block>\n                                                      </value>\n                                                      <statement name=\"DO0\">\n                                                          <!-- High-pitched Steam Whistle -->\n                                                          <block type=\"tecla_play_note\">\n                                                              <value name=\"NOTE\">\n                                                                  <block type=\"math_arithmetic\">\n                                                                      <field name=\"OP\">ADD</field>\n                                                                      <value name=\"A\"><shadow type=\"math_number\"><field name=\"NUM\">84</field></shadow></value>\n                                                                      <value name=\"B\">\n                                                                          <block type=\"math_arithmetic\">\n                                                                              <field name=\"OP\">DIVIDE</field>\n                                                                              <value name=\"A\"><block type=\"variables_get\"><field name=\"VAR\">steam_pressure</field></block></value>\n                                                                              <value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">8</field></shadow></value>\n                                                                          </block>\n                                                                      </value>\n                                                                  </block>\n                                                              </value>\n                                                              <value name=\"VELOCITY\">\n                                                                  <block type=\"math_arithmetic\">\n                                                                      <field name=\"OP\">ADD</field>\n                                                                      <value name=\"A\"><shadow type=\"math_number\"><field name=\"NUM\">80</field></shadow></value>\n                                                                      <value name=\"B\">\n                                                                          <block type=\"math_arithmetic\">\n                                                                              <field name=\"OP\">DIVIDE</field>\n                                                                              <value name=\"A\"><block type=\"variables_get\"><field name=\"VAR\">steam_pressure</field></block></value>\n                                                                              <value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">3</field></shadow></value>\n                                                                          </block>\n                                                                      </value>\n                                                                  </block>\n                                                              </value>\n                                                              <value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">0.2</field></shadow></value>\n                                                          </block>\n                                                      </statement>\n                                                      <next>\n                                                          <!-- Wait based on BPM (create mechanical tempo) -->\n                                                          <block type=\"tecla_wait\">\n                                                              <value name=\"TIME\">\n                                                                  <block type=\"math_arithmetic\">\n                                                                      <field name=\"OP\">DIVIDE</field>\n                                                                      <value name=\"A\"><shadow type=\"math_number\"><field name=\"NUM\">15</field></shadow></value>\n                                                                      <value name=\"B\"><block type=\"variables_get\"><field name=\"VAR\">machine_bpm</field></block></value>\n                                                                  </block>\n                                                              </value>\n                                                          </block>\n                                                      </next>\n                                                  </block>\n                                              </next>\n                                          </block>\n                                       </next>\n                                   </block>\n                                </next>\n                            </block>\n                         </next>\n                     </block>\n                  </next>\n                </block>\n             </next>\n           </block>\n        </next>\n      </block>\n    </statement>\n  </block>\n</xml>"
}
