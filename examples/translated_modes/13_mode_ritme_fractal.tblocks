{
  "name": "Mode Ritme Fractal (Auto)",
  "version": "1.0",
  "format": "legacy",
  "blocks": "<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <block type=\"tecla_repeat_forever\" x=\"50\" y=\"50\">\n    <statement name=\"DO\">\n      <block type=\"variables_set\">\n        <field name=\"VAR\">zoom</field>\n        <value name=\"VALUE\">\n           <!-- Slow Zoom -->\n           <block type=\"tecla_software_lfo\">\n               <value name=\"RATE\"><shadow type=\"math_number\"><field name=\"NUM\">0.2</field></shadow></value>\n               <value name=\"MIN\"><shadow type=\"math_number\"><field name=\"NUM\">0.5</field></shadow></value>\n               <value name=\"MAX\"><shadow type=\"math_number\"><field name=\"NUM\">2.0</field></shadow></value>\n           </block>\n        </value>\n        <next>\n             <!-- Pan X/Y -->\n             <block type=\"variables_set\">\n                 <field name=\"VAR\">pan_x</field>\n                 <value name=\"VALUE\">\n                     <block type=\"tecla_software_lfo\">\n                         <value name=\"RATE\"><shadow type=\"math_number\"><field name=\"NUM\">0.1</field></shadow></value>\n                         <value name=\"MIN\"><shadow type=\"math_number\"><field name=\"NUM\">-1.5</field></shadow></value>\n                         <value name=\"MAX\"><shadow type=\"math_number\"><field name=\"NUM\">0.5</field></shadow></value>\n                     </block>\n                 </value>\n                 <next>\n                     <!-- Iterate Grid -->\n                     <block type=\"controls_repeat_ext\">\n                         <value name=\"TIMES\"><shadow type=\"math_number\"><field name=\"NUM\">4</field></shadow></value>\n                         <statement name=\"DO\">\n                            <!-- Simplified Fractal Check for Rhythm -->\n                            <block type=\"controls_if\">\n                                <value name=\"IF0\">\n                                    <block type=\"logic_compare\">\n                                        <field name=\"OP\">LT</field>\n                                        <value name=\"A\">\n                                            <block type=\"tecla_math_random_int\">\n                                                <value name=\"FROM\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n                                                <value name=\"TO\"><shadow type=\"math_number\"><field name=\"NUM\">100</field></shadow></value>\n                                            </block>\n                                        </value>\n                                        <value name=\"B\">\n                                            <block type=\"math_arithmetic\">\n                                                <field name=\"OP\">MULTIPLY</field>\n                                                <value name=\"A\"><block type=\"variables_get\"><field name=\"VAR\">zoom</field></block></value>\n                                                <value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">30</field></shadow></value>\n                                            </block>\n                                        </value>\n                                    </block>\n                                </value>\n                                <statement name=\"DO0\">\n                                     <!-- Percussive Hit on Fractal Edge -->\n                                     <block type=\"tecla_play_note\">\n                                         <value name=\"NOTE\">\n                                              <block type=\"tecla_math_random_int\">\n                                                  <value name=\"FROM\"><shadow type=\"math_number\"><field name=\"NUM\">36</field></shadow></value>\n                                                  <value name=\"TO\"><shadow type=\"math_number\"><field name=\"NUM\">48</field></shadow></value>\n                                              </block>\n                                         </value>\n                                         <value name=\"VELOCITY\"><shadow type=\"math_number\"><field name=\"NUM\">100</field></shadow></value>\n                                         <value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">0.1</field></shadow></value>\n                                     </block>\n                                </statement>\n                                <next>\n                                     <block type=\"tecla_wait\">\n                                         <value name=\"TIME\"><shadow type=\"math_number\"><field name=\"NUM\">0.125</field></shadow></value>\n                                     </block>\n                                </next>\n                            </block>\n                         </statement>\n                     </block>\n                 </next>\n             </block>\n        </next>\n      </block>\n    </statement>\n  </block>\n</xml>"
}
