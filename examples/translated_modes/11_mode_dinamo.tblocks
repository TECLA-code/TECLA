{
  "name": "Mode Dinamo (Auto)",
  "version": "1.0",
  "format": "legacy",
  "blocks": "<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <block type=\"tecla_repeat_forever\" x=\"50\" y=\"50\">\n    <statement name=\"DO\">\n      <block type=\"variables_set\">\n        <field name=\"VAR\">base_note</field>\n        <value name=\"VALUE\">\n           <!-- Auto Base Note: Slow LFO 36-60 -->\n           <block type=\"tecla_software_lfo\">\n               <value name=\"RATE\"><shadow type=\"math_number\"><field name=\"NUM\">0.1</field></shadow></value>\n               <value name=\"MIN\"><shadow type=\"math_number\"><field name=\"NUM\">36</field></shadow></value>\n               <value name=\"MAX\"><shadow type=\"math_number\"><field name=\"NUM\">60</field></shadow></value>\n           </block>\n        </value>\n        <next>\n           <block type=\"variables_set\">\n             <field name=\"VAR\">intensity</field>\n             <value name=\"VALUE\">\n                <!-- Auto Intensity: Med LFO 40-100 -->\n                <block type=\"tecla_software_lfo\">\n                    <value name=\"RATE\"><shadow type=\"math_number\"><field name=\"NUM\">0.5</field></shadow></value>\n                    <value name=\"MIN\"><shadow type=\"math_number\"><field name=\"NUM\">40</field></shadow></value>\n                    <value name=\"MAX\"><shadow type=\"math_number\"><field name=\"NUM\">100</field></shadow></value>\n                </block>\n             </value>\n             <next>\n                <!-- Harmonics Generator -->\n                <block type=\"tecla_play_note\">\n                    <value name=\"NOTE\"><block type=\"variables_get\"><field name=\"VAR\">base_note</field></block></value>\n                    <value name=\"VELOCITY\"><block type=\"variables_get\"><field name=\"VAR\">intensity</field></block></value>\n                    <value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">0.2</field></shadow></value>\n                    <next>\n                        <block type=\"tecla_play_note\">\n                            <value name=\"NOTE\">\n                                <block type=\"math_arithmetic\">\n                                    <field name=\"OP\">ADD</field>\n                                    <value name=\"A\"><block type=\"variables_get\"><field name=\"VAR\">base_note</field></block></value>\n                                    <value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">7</field></shadow></value>\n                                </block>\n                            </value>\n                            <value name=\"VELOCITY\">\n                                <block type=\"math_arithmetic\">\n                                    <field name=\"OP\">DIVIDE</field>\n                                    <value name=\"A\"><block type=\"variables_get\"><field name=\"VAR\">intensity</field></block></value>\n                                    <value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">1.5</field></shadow></value>\n                                </block>\n                            </value>\n                            <value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">0.2</field></shadow></value>\n                            <next>\n                                <block type=\"tecla_play_note\">\n                                    <value name=\"NOTE\">\n                                        <block type=\"math_arithmetic\">\n                                            <field name=\"OP\">ADD</field>\n                                            <value name=\"A\"><block type=\"variables_get\"><field name=\"VAR\">base_note</field></block></value>\n                                            <value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">12</field></shadow></value>\n                                        </block>\n                                    </value>\n                                    <value name=\"VELOCITY\">\n                                        <block type=\"math_arithmetic\">\n                                            <field name=\"OP\">DIVIDE</field>\n                                            <value name=\"A\"><block type=\"variables_get\"><field name=\"VAR\">intensity</field></block></value>\n                                            <value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">2</field></shadow></value>\n                                        </block>\n                                    </value>\n                                    <value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">0.2</field></shadow></value>\n                                    <next>\n                                        <block type=\"tecla_wait\">\n                                            <value name=\"TIME\"><shadow type=\"math_number\"><field name=\"NUM\">0.1</field></shadow></value>\n                                        </block>\n                                    </next>\n                                </block>\n                            </next>\n                        </block>\n                    </next>\n                </block>\n             </next>\n           </block>\n        </next>\n      </block>\n    </statement>\n  </block>\n</xml>"
}
