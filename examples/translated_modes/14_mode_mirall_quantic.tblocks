{
  "name": "Mirall Quàntic (Auto)",
  "version": "1.0",
  "format": "legacy",
  "blocks": "<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <block type=\"tecla_repeat_forever\" x=\"50\" y=\"50\">\n    <statement name=\"DO\">\n       <block type=\"variables_set\">\n           <field name=\"VAR\">uncertainty</field>\n           <value name=\"VALUE\">\n                <!-- Uncertainty fluctuates over time -->\n                <block type=\"tecla_software_lfo\">\n                    <value name=\"RATE\"><shadow type=\"math_number\"><field name=\"NUM\">0.1</field></shadow></value>\n                    <value name=\"MIN\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n                    <value name=\"MAX\"><shadow type=\"math_number\"><field name=\"NUM\">100</field></shadow></value>\n                </block>\n           </value>\n           <next>\n               <!-- Observer Event (Random Collapse) -->\n               <block type=\"controls_if\">\n                   <mutation else=\"1\"></mutation>\n                   <value name=\"IF0\">\n                       <block type=\"tecla_probability\">\n                           <value name=\"PERCENT\"><shadow type=\"math_number\"><field name=\"NUM\">30</field></shadow></value>\n                       </block>\n                   </value>\n                   <statement name=\"DO0\">\n                       <!-- Observed: Definite Particle (Note) -->\n                       <block type=\"tecla_play_note\">\n                           <value name=\"NOTE\">\n                               <block type=\"tecla_scale_quantize\">\n                                   <field name=\"SCALE\">dorian</field>\n                                   <field name=\"ROOT\">C</field>\n                                   <value name=\"VALUE\">\n                                       <block type=\"tecla_math_random_int\">\n                                           <value name=\"FROM\"><shadow type=\"math_number\"><field name=\"NUM\">48</field></shadow></value>\n                                           <value name=\"TO\"><shadow type=\"math_number\"><field name=\"NUM\">72</field></shadow></value>\n                                       </block>\n                                   </value>\n                               </block>\n                           </value>\n                           <value name=\"VELOCITY\"><shadow type=\"math_number\"><field name=\"NUM\">100</field></shadow></value>\n                           <value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">0.5</field></shadow></value>\n                       </block>\n                   </statement>\n                   <statement name=\"ELSE\">\n                       <!-- Unobserved: Superposition (Probabilistic Tones) -->\n                       <block type=\"controls_repeat_ext\">\n                           <value name=\"TIMES\">\n                               <block type=\"math_arithmetic\">\n                                   <field name=\"OP\">DIVIDE</field>\n                                   <value name=\"A\"><block type=\"variables_get\"><field name=\"VAR\">uncertainty</field></block></value>\n                                   <value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">20</field></shadow></value>\n                               </block>\n                           </value>\n                           <statement name=\"DO\">\n                               <block type=\"tecla_play_note\">\n                                   <value name=\"NOTE\">\n                                        <block type=\"tecla_math_random_int\">\n                                            <value name=\"FROM\"><shadow type=\"math_number\"><field name=\"NUM\">72</field></shadow></value>\n                                            <value name=\"TO\"><shadow type=\"math_number\"><field name=\"NUM\">96</field></shadow></value>\n                                        </block>\n                                   </value>\n                                   <value name=\"VELOCITY\"><shadow type=\"math_number\"><field name=\"NUM\">40</field></shadow></value>\n                                   <value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">0.05</field></shadow></value>\n                                   <next>\n                                        <block type=\"tecla_wait\">\n                                            <value name=\"TIME\"><shadow type=\"math_number\"><field name=\"NUM\">0.05</field></shadow></value>\n                                        </block>\n                                   </next>\n                               </block>\n                           </statement>\n                       </block>\n                   </statement>\n                   <next>\n                       <block type=\"tecla_wait\">\n                           <value name=\"TIME\"><shadow type=\"math_number\"><field name=\"NUM\">0.1</field></shadow></value>\n                       </block>\n                   </next>\n               </block>\n           </next>\n       </block>\n    </statement>\n  </block>\n</xml>"
}
