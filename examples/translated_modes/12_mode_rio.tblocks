{
  "name": "Mode Riu (Auto)",
  "version": "1.0",
  "format": "legacy",
  "blocks": "<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <block type=\"tecla_repeat_forever\" x=\"50\" y=\"50\">\n    <statement name=\"DO\">\n      <block type=\"variables_set\">\n        <field name=\"VAR\">flow_rate</field>\n        <value name=\"VALUE\">\n           <!-- Auto Flow: Slow LFO 0.05Hz 0-100 -->\n           <block type=\"tecla_software_lfo\">\n               <value name=\"RATE\"><shadow type=\"math_number\"><field name=\"NUM\">0.05</field></shadow></value>\n               <value name=\"MIN\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n               <value name=\"MAX\"><shadow type=\"math_number\"><field name=\"NUM\">100</field></shadow></value>\n           </block>\n        </value>\n        <next>\n            <block type=\"controls_if\">\n                <mutation else=\"1\"></mutation>\n                <value name=\"IF0\">\n                    <!-- If Flow < 50 => Calm (Pentatonic) -->\n                    <block type=\"logic_compare\">\n                        <field name=\"OP\">LT</field>\n                        <value name=\"A\"><block type=\"variables_get\"><field name=\"VAR\">flow_rate</field></block></value>\n                        <value name=\"B\"><block type=\"math_number\"><field name=\"NUM\">50</field></block></value>\n                    </block>\n                </value>\n                <statement name=\"DO0\">\n                    <!-- Calm Water -->\n                     <block type=\"tecla_probability\">\n                        <value name=\"PERCENT\"><shadow type=\"math_number\"><field name=\"NUM\">70</field></shadow></value>\n                        <statement name=\"DO\">\n                             <block type=\"tecla_play_note\">\n                                 <value name=\"NOTE\">\n                                     <block type=\"tecla_scale_quantize\">\n                                         <field name=\"SCALE\">pentatonic</field>\n                                         <field name=\"ROOT\">C</field>\n                                         <value name=\"VALUE\">\n                                             <block type=\"tecla_math_random_int\">\n                                                 <value name=\"FROM\"><shadow type=\"math_number\"><field name=\"NUM\">60</field></shadow></value>\n                                                 <value name=\"TO\"><shadow type=\"math_number\"><field name=\"NUM\">84</field></shadow></value>\n                                             </block>\n                                         </value>\n                                     </block>\n                                 </value>\n                                 <value name=\"VELOCITY\"><shadow type=\"math_number\"><field name=\"NUM\">60</field></shadow></value>\n                                 <value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">0.5</field></shadow></value>\n                             </block>\n                        </statement>\n                     </block>\n                </statement>\n                <statement name=\"ELSE\">\n                    <!-- Rapid Water (Blues) -->\n                     <block type=\"tecla_probability\">\n                        <value name=\"PERCENT\"><shadow type=\"math_number\"><field name=\"NUM\">90</field></shadow></value>\n                        <statement name=\"DO\">\n                             <block type=\"tecla_play_note\">\n                                 <value name=\"NOTE\">\n                                     <block type=\"tecla_scale_quantize\">\n                                         <field name=\"SCALE\">blues</field>\n                                         <field name=\"ROOT\">C</field>\n                                         <value name=\"VALUE\">\n                                             <block type=\"tecla_math_random_int\">\n                                                 <value name=\"FROM\"><shadow type=\"math_number\"><field name=\"NUM\">48</field></shadow></value>\n                                                 <value name=\"TO\"><shadow type=\"math_number\"><field name=\"NUM\">72</field></shadow></value>\n                                             </block>\n                                         </value>\n                                     </block>\n                                 </value>\n                                 <value name=\"VELOCITY\"><shadow type=\"math_number\"><field name=\"NUM\">90</field></shadow></value>\n                                 <value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">0.2</field></shadow></value>\n                             </block>\n                        </statement>\n                     </block>\n                </statement>\n                <next>\n                    <block type=\"tecla_wait\">\n                        <!-- Speed varies with flow -->\n                        <value name=\"TIME\">\n                             <block type=\"tecla_math_map\">\n                                 <value name=\"VALUE\"><block type=\"variables_get\"><field name=\"VAR\">flow_rate</field></block></value>\n                                 <value name=\"FROM_MIN\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n                                 <value name=\"FROM_MAX\"><shadow type=\"math_number\"><field name=\"NUM\">100</field></shadow></value>\n                                 <value name=\"TO_MIN\"><shadow type=\"math_number\"><field name=\"NUM\">0.3</field></shadow></value>\n                                 <value name=\"TO_MAX\"><shadow type=\"math_number\"><field name=\"NUM\">0.1</field></shadow></value>\n                             </block>\n                        </value>\n                    </block>\n                </next>\n            </block>\n        </next>\n      </block>\n    </statement>\n  </block>\n</xml>"
}
