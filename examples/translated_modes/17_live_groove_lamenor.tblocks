{
  "name": "Live Groove – La menor",
  "version": "1.0",
  "format": "legacy",
  "blocks": "<xml xmlns=\"https://developers.google.com/blockly/xml\">\n\n  <!-- BLOC PRINCIPAL: Configuració + groove en loop -->\n  <block type=\"tecla_set_bpm\" x=\"50\" y=\"50\">\n    <value name=\"BPM\"><shadow type=\"math_number\"><field name=\"NUM\">120</field></shadow></value>\n    <next>\n      <block type=\"tecla_midi_cc\">\n        <field name=\"CC_TYPE\">91</field>\n        <value name=\"CC_NUM\"><shadow type=\"math_number\"><field name=\"NUM\">91</field></shadow></value>\n        <value name=\"CC_VAL\"><shadow type=\"math_number\"><field name=\"NUM\">55</field></shadow></value>\n        <next>\n          <block type=\"tecla_midi_cc\">\n            <field name=\"CC_TYPE\">74</field>\n            <value name=\"CC_NUM\"><shadow type=\"math_number\"><field name=\"NUM\">74</field></shadow></value>\n            <value name=\"CC_VAL\"><shadow type=\"math_number\"><field name=\"NUM\">40</field></shadow></value>\n            <next>\n              <block type=\"tecla_repeat_forever\">\n                <statement name=\"DO\">\n                  <block type=\"tecla_drum_hit\">\n                    <field name=\"DRUM\">36</field>\n                    <value name=\"VELOCITY\"><shadow type=\"math_number\"><field name=\"NUM\">110</field></shadow></value>\n                    <next>\n                      <block type=\"tecla_wait_beat\">\n                        <field name=\"BEATS\">1</field>\n                        <next>\n                          <block type=\"tecla_drum_hit\">\n                            <field name=\"DRUM\">42</field>\n                            <value name=\"VELOCITY\"><shadow type=\"math_number\"><field name=\"NUM\">60</field></shadow></value>\n                            <next>\n                              <block type=\"tecla_wait_beat\">\n                                <field name=\"BEATS\">0.5</field>\n                                <next>\n                                  <block type=\"tecla_drum_hit\">\n                                    <field name=\"DRUM\">38</field>\n                                    <value name=\"VELOCITY\">\n                                      <block type=\"tecla_humanize_vel\">\n                                        <value name=\"BASE_VEL\"><shadow type=\"math_number\"><field name=\"NUM\">88</field></shadow></value>\n                                        <value name=\"SPREAD\"><shadow type=\"math_number\"><field name=\"NUM\">15</field></shadow></value>\n                                      </block>\n                                    </value>\n                                    <next>\n                                      <block type=\"tecla_wait_beat\">\n                                        <field name=\"BEATS\">0.5</field>\n                                        <next>\n                                          <block type=\"tecla_drum_hit\">\n                                            <field name=\"DRUM\">42</field>\n                                            <value name=\"VELOCITY\"><shadow type=\"math_number\"><field name=\"NUM\">45</field></shadow></value>\n                                            <next>\n                                              <block type=\"tecla_wait_beat\">\n                                                <field name=\"BEATS\">1</field>\n                                                <next>\n                                                  <block type=\"tecla_arpeggio_dir\">\n                                                    <field name=\"CHORD\">Am</field>\n                                                    <field name=\"DIR\">updown</field>\n                                                    <value name=\"SPEED\"><shadow type=\"math_number\"><field name=\"NUM\">0.12</field></shadow></value>\n                                                  </block>\n                                                </next>\n                                              </block>\n                                            </next>\n                                          </block>\n                                        </next>\n                                      </block>\n                                    </next>\n                                  </block>\n                                </next>\n                              </block>\n                            </next>\n                          </block>\n                        </next>\n                      </block>\n                    </next>\n                  </block>\n                </statement>\n              </block>\n            </next>\n          </block>\n        </next>\n      </block>\n    </next>\n  </block>\n\n  <!-- EINES FLOTANTS per Live Coding -->\n\n  <block type=\"tecla_seq_play_steps\" x=\"530\" y=\"50\">\n    <field name=\"NOTES\">57,60,64,69,67,64,60,57</field>\n    <value name=\"VELOCITY\">\n      <block type=\"tecla_humanize_vel\">\n        <value name=\"BASE_VEL\"><shadow type=\"math_number\"><field name=\"NUM\">85</field></shadow></value>\n        <value name=\"SPREAD\"><shadow type=\"math_number\"><field name=\"NUM\">12</field></shadow></value>\n      </block>\n    </value>\n    <value name=\"STEP_DUR\"><shadow type=\"math_number\"><field name=\"NUM\">0.18</field></shadow></value>\n  </block>\n\n  <block type=\"tecla_crescendo\" x=\"530\" y=\"200\">\n    <field name=\"CC\">74</field>\n    <value name=\"FROM_VAL\"><shadow type=\"math_number\"><field name=\"NUM\">20</field></shadow></value>\n    <value name=\"TO_VAL\"><shadow type=\"math_number\"><field name=\"NUM\">110</field></shadow></value>\n    <value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">8.0</field></shadow></value>\n  </block>\n\n  <block type=\"tecla_chord_progression\" x=\"530\" y=\"340\">\n    <field name=\"PROG\">modern</field>\n    <field name=\"KEY\">9</field>\n    <value name=\"BEATS_DUR\"><shadow type=\"math_number\"><field name=\"NUM\">1.5</field></shadow></value>\n  </block>\n\n  <block type=\"tecla_note_on_only\" x=\"530\" y=\"470\">\n    <value name=\"NOTE\">\n      <block type=\"tecla_note_name\"><field name=\"NOTE\">45</field></block>\n    </value>\n    <value name=\"VELOCITY\"><shadow type=\"math_number\"><field name=\"NUM\">65</field></shadow></value>\n    <next>\n      <block type=\"tecla_wait\">\n        <value name=\"TIME\"><shadow type=\"math_number\"><field name=\"NUM\">4.0</field></shadow></value>\n        <next>\n          <block type=\"tecla_note_off_only\">\n            <value name=\"NOTE\">\n              <block type=\"tecla_note_name\"><field name=\"NOTE\">45</field></block>\n            </value>\n          </block>\n        </next>\n      </block>\n    </next>\n  </block>\n\n  <block type=\"tecla_riff_repeat\" x=\"530\" y=\"650\">\n    <field name=\"TIMES\">4</field>\n    <field name=\"EACH_TRANSPOSE\">5</field>\n    <statement name=\"RIFF\">\n      <block type=\"tecla_seq_play_steps\">\n        <field name=\"NOTES\">60,64,67,72</field>\n        <value name=\"VELOCITY\"><shadow type=\"math_number\"><field name=\"NUM\">90</field></shadow></value>\n        <value name=\"STEP_DUR\"><shadow type=\"math_number\"><field name=\"NUM\">0.2</field></shadow></value>\n      </block>\n    </statement>\n  </block>\n\n  <block type=\"tecla_drum_pattern\" x=\"530\" y=\"810\">\n    <field name=\"DRUM\">36</field>\n    <field name=\"PATTERN\">1010000110100001</field>\n    <value name=\"STEP_DUR\"><shadow type=\"math_number\"><field name=\"NUM\">0.125</field></shadow></value>\n  </block>\n\n  <block type=\"tecla_midi_sustain\" x=\"530\" y=\"940\">\n    <field name=\"STATE\">127</field>\n  </block>\n\n  <block type=\"tecla_midi_pitch_bend\" x=\"530\" y=\"1010\">\n    <value name=\"AMOUNT\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n  </block>\n\n  <block type=\"tecla_midi_all_notes_off\" x=\"530\" y=\"1080\"></block>\n\n</xml>"
}
