{
  "name": "Mode Biomímesi",
  "version": "1.0",
  "format": "legacy",
  "blocks": "<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <block type=\"tecla_repeat_forever\" x=\"50\" y=\"50\">\n    <statement name=\"DO\">\n      <block type=\"controls_if\">\n         <!-- Biological Cycle: Respiration (Slow, Sine) -->\n         <mutation else=\"1\"></mutation>\n         <value name=\"IF0\">\n             <block type=\"tecla_probability\">\n                 <value name=\"PERCENT\"><shadow type=\"math_number\"><field name=\"NUM\">90</field></shadow></value>\n             </block>\n         </value>\n         <statement name=\"DO0\">\n            <block type=\"tecla_play_note\">\n                <value name=\"NOTE\">\n                    <block type=\"math_arithmetic\">\n                        <field name=\"OP\">ADD</field>\n                        <value name=\"A\"><shadow type=\"math_number\"><field name=\"NUM\">60</field></shadow></value>\n                        <value name=\"B\">\n                            <block type=\"tecla_software_lfo\">\n                                <value name=\"RATE\"><shadow type=\"math_number\"><field name=\"NUM\">0.3</field></shadow></value>\n                                <value name=\"MIN\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n                                <value name=\"MAX\"><shadow type=\"math_number\"><field name=\"NUM\">12</field></shadow></value>\n                            </block>\n                        </value>\n                    </block>\n                </value>\n                <value name=\"VELOCITY\">\n                    <block type=\"tecla_software_lfo\">\n                         <value name=\"RATE\"><shadow type=\"math_number\"><field name=\"NUM\">0.3</field></shadow></value>\n                         <value name=\"MIN\"><shadow type=\"math_number\"><field name=\"NUM\">40</field></shadow></value>\n                         <value name=\"MAX\"><shadow type=\"math_number\"><field name=\"NUM\">100</field></shadow></value>\n                    </block>\n                </value>\n                <value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">0.5</field></shadow></value>\n            </block>\n         </statement>\n         <statement name=\"ELSE\">\n            <!-- Biological Cycle: Nervous (Fast, Random) -->\n             <block type=\"tecla_probability\">\n                <value name=\"PERCENT\"><shadow type=\"math_number\"><field name=\"NUM\">30</field></shadow></value>\n                <statement name=\"DO\">\n                   <block type=\"tecla_play_note\">\n                        <value name=\"NOTE\">\n                            <block type=\"tecla_math_random_int\">\n                                <value name=\"FROM\"><shadow type=\"math_number\"><field name=\"NUM\">70</field></shadow></value>\n                                <value name=\"TO\"><shadow type=\"math_number\"><field name=\"NUM\">90</field></shadow></value>\n                            </block>\n                        </value>\n                        <value name=\"VELOCITY\"><shadow type=\"math_number\"><field name=\"NUM\">80</field></shadow></value>\n                        <value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">0.1</field></shadow></value>\n                   </block>\n                </statement>\n             </block>\n         </statement>\n         <next>\n            <block type=\"tecla_wait\">\n                <value name=\"TIME\"><shadow type=\"math_number\"><field name=\"NUM\">0.1</field></shadow></value>\n            </block>\n         </next>\n      </block>\n    </statement>\n  </block>\n</xml>"
}
