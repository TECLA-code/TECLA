{
  "name": "Mode Tormenta (Auto)",
  "version": "1.0",
  "format": "legacy",
  "blocks": "<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <block type=\"tecla_repeat_forever\" x=\"50\" y=\"50\">\n    <statement name=\"DO\">\n      <block type=\"variables_set\">\n        <field name=\"VAR\">storm_intensity</field>\n        <value name=\"VALUE\">\n           <!-- Storm Cycle: Very Slow Rise/Fall -->\n           <block type=\"tecla_software_lfo\">\n               <value name=\"RATE\"><shadow type=\"math_number\"><field name=\"NUM\">0.05</field></shadow></value>\n               <value name=\"MIN\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n               <value name=\"MAX\"><shadow type=\"math_number\"><field name=\"NUM\">100</field></shadow></value>\n           </block>\n        </value>\n        <next>\n            <!-- Background Rain/Wind (Low Noise/Drone) -->\n            <block type=\"tecla_play_note\">\n                <value name=\"NOTE\">\n                    <block type=\"math_random_int\">\n                        <value name=\"FROM\"><shadow type=\"math_number\"><field name=\"NUM\">30</field></shadow></value>\n                        <value name=\"TO\"><shadow type=\"math_number\"><field name=\"NUM\">36</field></shadow></value>\n                    </block>\n                </value>\n                <value name=\"VELOCITY\"><block type=\"variables_get\"><field name=\"VAR\">storm_intensity</field></block></value>\n                <value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">0.5</field></shadow></value>\n                <next>\n                    <!-- Thunder/Lightning Events -->\n                    <block type=\"controls_if\">\n                        <value name=\"IF0\">\n                            <block type=\"tecla_probability\">\n                                <value name=\"PERCENT\"><block type=\"variables_get\"><field name=\"VAR\">storm_intensity</field></block></value>\n                            </block>\n                        </value>\n                        <statement name=\"DO0\">\n                            <!-- Lightning Strike (High Cluster) -->\n                            <block type=\"controls_repeat_ext\">\n                                <value name=\"TIMES\"><shadow type=\"math_number\"><field name=\"NUM\">5</field></shadow></value>\n                                <statement name=\"DO\">\n                                     <block type=\"tecla_play_note\">\n                                         <value name=\"NOTE\">\n                                              <block type=\"math_random_int\">\n                                                  <value name=\"FROM\"><shadow type=\"math_number\"><field name=\"NUM\">90</field></shadow></value>\n                                                  <value name=\"TO\"><shadow type=\"math_number\"><field name=\"NUM\">108</field></shadow></value>\n                                              </block>\n                                         </value>\n                                         <value name=\"VELOCITY\">\n                                              <block type=\"math_arithmetic\">\n                                                  <field name=\"OP\">ADD</field>\n                                                  <value name=\"A\"><shadow type=\"math_number\"><field name=\"NUM\">80</field></shadow></value>\n                                                  <value name=\"B\"><block type=\"math_arithmetic\"><field name=\"OP\">DIVIDE</field><value name=\"A\"><block type=\"variables_get\"><field name=\"VAR\">storm_intensity</field></block></value><value name=\"B\"><block type=\"math_number\"><field name=\"NUM\">2</field></block></value></block></value>\n                                              </block>\n                                         </value>\n                                         <value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">0.05</field></shadow></value>\n                                     </block>\n                                </statement>\n                                <next>\n                                     <!-- Thunder Follow-up (Low Rumble) -->\n                                     <block type=\"tecla_wait\">\n                                         <value name=\"TIME\"><shadow type=\"math_number\"><field name=\"NUM\">0.2</field></shadow></value>\n                                         <next>\n                                             <block type=\"tecla_play_note\">\n                                                 <value name=\"NOTE\">\n                                                      <block type=\"math_random_int\">\n                                                          <value name=\"FROM\"><shadow type=\"math_number\"><field name=\"NUM\">24</field></shadow></value>\n                                                          <value name=\"TO\"><shadow type=\"math_number\"><field name=\"NUM\">36</field></shadow></value>\n                                                      </block>\n                                                 </value>\n                                                 <value name=\"VELOCITY\"><shadow type=\"math_number\"><field name=\"NUM\">100</field></shadow></value>\n                                                 <value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">1.0</field></shadow></value>\n                                             </block>\n                                         </next>\n                                     </block>\n                                </next>\n                            </block>\n                        </statement>\n                    </block>\n                </next>\n            </block>\n        </next>\n      </block>\n    </statement>\n  </block>\n</xml>"
}
