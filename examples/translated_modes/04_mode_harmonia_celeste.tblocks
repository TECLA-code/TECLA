{
  "name": "Mode Harmonia Celeste",
  "version": "1.0",
  "format": "legacy",
  "blocks": "<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <block type=\"tecla_repeat_forever\" x=\"50\" y=\"50\">\n    <statement name=\"DO\">\n      <!-- Harmonia Celeste Simulation -->\n      <!-- 3 Planets (Orbits) represented by logic blocks -->\n      \n      <!-- Planet 1: Mercury (Fast) -->\n      <block type=\"tecla_probability\">\n        <value name=\"PERCENT\"><shadow type=\"math_number\"><field name=\"NUM\">80</field></shadow></value>\n        <statement name=\"DO\">\n           <block type=\"tecla_play_note\">\n             <value name=\"NOTE\">\n                <block type=\"tecla_scale_quantize\">\n                    <field name=\"SCALE\">pentatonic</field>\n                    <field name=\"ROOT\">C</field>\n                    <value name=\"VALUE\">\n                        <block type=\"tecla_software_lfo\">\n                            <value name=\"RATE\"><shadow type=\"math_number\"><field name=\"NUM\">0.5</field></shadow></value> <!-- Fast Period -->\n                            <value name=\"MIN\"><shadow type=\"math_number\"><field name=\"NUM\">60</field></shadow></value>\n                            <value name=\"MAX\"><shadow type=\"math_number\"><field name=\"NUM\">84</field></shadow></value>\n                        </block>\n                    </value>\n                </block>\n             </value>\n             <value name=\"VELOCITY\"><shadow type=\"math_number\"><field name=\"NUM\">90</field></shadow></value>\n             <value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">0.2</field></shadow></value>\n           </block>\n        </statement>\n        <next>\n          <!-- Planet 2: Venus (Medium) -->\n          <block type=\"tecla_probability\">\n            <value name=\"PERCENT\"><shadow type=\"math_number\"><field name=\"NUM\">60</field></shadow></value>\n            <statement name=\"DO\">\n               <block type=\"tecla_play_note\">\n                 <value name=\"NOTE\">\n                    <block type=\"tecla_scale_quantize\">\n                        <field name=\"SCALE\">pentatonic</field>\n                        <field name=\"ROOT\">C</field>\n                        <value name=\"VALUE\">\n                            <block type=\"tecla_software_lfo\">\n                                <value name=\"RATE\"><shadow type=\"math_number\"><field name=\"NUM\">0.2</field></shadow></value> <!-- Med Period -->\n                                <value name=\"MIN\"><shadow type=\"math_number\"><field name=\"NUM\">48</field></shadow></value>\n                                <value name=\"MAX\"><shadow type=\"math_number\"><field name=\"NUM\">72</field></shadow></value>\n                            </block>\n                        </value>\n                    </block>\n                 </value>\n                 <value name=\"VELOCITY\"><shadow type=\"math_number\"><field name=\"NUM\">80</field></shadow></value>\n                 <value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">0.4</field></shadow></value>\n               </block>\n            </statement>\n            <next>\n              <!-- Planet 3: Jupiter (Slow, Deep) -->\n              <block type=\"tecla_probability\">\n                <value name=\"PERCENT\"><shadow type=\"math_number\"><field name=\"NUM\">40</field></shadow></value>\n                <statement name=\"DO\">\n                   <block type=\"tecla_play_note\">\n                     <value name=\"NOTE\">\n                        <block type=\"tecla_scale_quantize\">\n                            <field name=\"SCALE\">pentatonic</field>\n                            <field name=\"ROOT\">C</field>\n                            <value name=\"VALUE\">\n                                <block type=\"tecla_software_lfo\">\n                                    <value name=\"RATE\"><shadow type=\"math_number\"><field name=\"NUM\">0.05</field></shadow></value> <!-- Slow Period -->\n                                    <value name=\"MIN\"><shadow type=\"math_number\"><field name=\"NUM\">36</field></shadow></value>\n                                    <value name=\"MAX\"><shadow type=\"math_number\"><field name=\"NUM\">60</field></shadow></value>\n                                </block>\n                            </value>\n                        </block>\n                     </value>\n                     <value name=\"VELOCITY\"><shadow type=\"math_number\"><field name=\"NUM\">100</field></shadow></value>\n                     <value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">1.0</field></shadow></value>\n                   </block>\n                </statement>\n                <next>\n                    <block type=\"tecla_wait\">\n                        <value name=\"TIME\"><shadow type=\"math_number\"><field name=\"NUM\">0.1</field></shadow></value>\n                    </block>\n                </next>\n              </block>\n            </next>\n          </block>\n        </next>\n      </block>\n    </statement>\n  </block>\n</xml>"
}
