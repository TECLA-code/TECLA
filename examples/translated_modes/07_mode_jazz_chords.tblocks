{
  "name": "Mode Jazz Chords",
  "version": "1.0",
  "format": "legacy",
  "blocks": "<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <block type=\"tecla_repeat_forever\" x=\"50\" y=\"50\">\n    <statement name=\"DO\">\n      <block type=\"controls_if\">\n        <mutation else=\"1\"></mutation>\n        <value name=\"IF0\">\n          <block type=\"tecla_read_button\">\n             <field name=\"BUTTON\">1</field>\n          </block>\n        </value>\n        <statement name=\"DO0\">\n           <!-- II-V-I Progression -->\n           <block type=\"tecla_play_chord\">\n               <field name=\"CHORD\">Dm</field>\n               <field name=\"DURATION\">0.8</field>\n               <next>\n                   <block type=\"tecla_play_chord\">\n                       <field name=\"CHORD\">G</field>\n                       <field name=\"DURATION\">0.8</field>\n                       <next>\n                           <block type=\"tecla_play_chord\">\n                               <field name=\"CHORD\">C</field>\n                               <field name=\"DURATION\">1.6</field>\n                           </block>\n                       </next>\n                   </block>\n               </next>\n           </block>\n        </statement>\n        <statement name=\"ELSE\">\n           <!-- Random Jazz Chord -->\n            <block type=\"tecla_probability\">\n                <value name=\"PERCENT\"><shadow type=\"math_number\"><field name=\"NUM\">50</field></shadow></value>\n                <statement name=\"DO\">\n                     <block type=\"tecla_play_chord\">\n                         <field name=\"CHORD\">Am</field>\n                         <field name=\"DURATION\">1</field>\n                     </block>\n                </statement>\n                <next>\n                     <block type=\"tecla_wait\">\n                         <value name=\"TIME\"><shadow type=\"math_number\"><field name=\"NUM\">0.1</field></shadow></value>\n                     </block>\n                </next>\n            </block>\n        </statement>\n      </block>\n    </statement>\n  </block>\n</xml>"
}
