{
  "name": "Mode Rítmic Loop",
  "version": "1.0",
  "format": "legacy",
  "blocks": "<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <block type=\"tecla_repeat_forever\" x=\"50\" y=\"50\">\n    <statement name=\"DO\">\n      <block type=\"variables_set\">\n        <field name=\"VAR\">bpm_val</field>\n        <value name=\"VALUE\">\n          <block type=\"tecla_math_map\">\n            <value name=\"VALUE\">\n              <block type=\"tecla_read_pot\">\n                <field name=\"POT\">1</field>\n              </block>\n            </value>\n            <value name=\"FROM_MIN\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n            <value name=\"FROM_MAX\"><shadow type=\"math_number\"><field name=\"NUM\">127</field></shadow></value>\n            <value name=\"TO_MIN\"><shadow type=\"math_number\"><field name=\"NUM\">60</field></shadow></value>\n            <value name=\"TO_MAX\"><shadow type=\"math_number\"><field name=\"NUM\">180</field></shadow></value>\n          </block>\n        </value>\n        <next>\n          <block type=\"tecla_set_bpm\">\n            <value name=\"BPM\">\n              <block type=\"variables_get\">\n                <field name=\"VAR\">bpm_val</field>\n              </block>\n            </value>\n            <next>\n              <block type=\"controls_if\">\n                <mutation else=\"1\"></mutation>\n                <value name=\"IF0\">\n                  <block type=\"tecla_euclidean_rhythm\">\n                    <value name=\"STEP\">\n                       <block type=\"variables_get\"><field name=\"VAR\">step</field></block>\n                    </value>\n                    <value name=\"PULSES\">\n                       <shadow type=\"math_number\"><field name=\"NUM\">5</field></shadow>\n                    </value>\n                    <value name=\"STEPS\">\n                       <shadow type=\"math_number\"><field name=\"NUM\">16</field></shadow>\n                    </value>\n                  </block>\n                </value>\n                <statement name=\"DO0\">\n                  <block type=\"tecla_play_note\">\n                    <value name=\"NOTE\">\n                      <shadow type=\"math_number\">\n                        <field name=\"NUM\">36</field>\n                      </shadow>\n                    </value>\n                    <value name=\"VELOCITY\">\n                      <block type=\"tecla_read_pot\">\n                        <field name=\"POT\">0</field>\n                      </block>\n                    </value>\n                    <value name=\"DURATION\">\n                      <shadow type=\"math_number\">\n                        <field name=\"NUM\">0.1</field>\n                      </shadow>\n                    </value>\n                  </block>\n                </statement>\n                <next>\n                  <block type=\"variables_set\">\n                    <field name=\"VAR\">step</field>\n                    <value name=\"VALUE\">\n                      <block type=\"math_arithmetic\">\n                        <field name=\"OP\">ADD</field>\n                        <value name=\"A\">\n                          <block type=\"variables_get\">\n                            <field name=\"VAR\">step</field>\n                          </block>\n                        </value>\n                        <value name=\"B\">\n                          <shadow type=\"math_number\">\n                            <field name=\"NUM\">1</field>\n                          </shadow>\n                        </value>\n                      </block>\n                    </value>\n                    <next>\n                        <block type=\"tecla_wait_beat\">\n                            <field name=\"BEATS\">0.25</field>\n                        </block>\n                    </next>\n                  </block>\n                </next>\n              </block>\n            </next>\n          </block>\n        </next>\n      </block>\n    </statement>\n  </block>\n</xml>"
}
