{
  "name": "Mode Matemàtic Harmònic",
  "version": "1.0",
  "format": "legacy",
  "blocks": "<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <block type=\"tecla_repeat_forever\" x=\"50\" y=\"50\">\n    <statement name=\"DO\">\n      <block type=\"controls_if\">\n         <mutation else=\"1\"></mutation>\n         <value name=\"IF0\">\n             <!-- Generate complex wave using multiple LFOs -->\n             <block type=\"tecla_probability\">\n                <value name=\"PERCENT\">\n                    <block type=\"math_arithmetic\">\n                        <field name=\"OP\">ADD</field>\n                        <value name=\"A\">\n                            <block type=\"tecla_software_lfo\">\n                                <value name=\"RATE\"><shadow type=\"math_number\"><field name=\"NUM\">0.5</field></shadow></value>\n                                <value name=\"MIN\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n                                <value name=\"MAX\"><shadow type=\"math_number\"><field name=\"NUM\">50</field></shadow></value>\n                            </block>\n                        </value>\n                        <value name=\"B\">\n                            <block type=\"tecla_software_lfo\">\n                                <value name=\"RATE\"><shadow type=\"math_number\"><field name=\"NUM\">1.3</field></shadow></value>\n                                <value name=\"MIN\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n                                <value name=\"MAX\"><shadow type=\"math_number\"><field name=\"NUM\">50</field></shadow></value>\n                            </block>\n                        </value>\n                    </block>\n                </value>\n             </block>\n         </value>\n         <statement name=\"DO0\">\n             <block type=\"tecla_play_note\">\n                 <value name=\"NOTE\">\n                     <block type=\"tecla_scale_quantize\">\n                         <field name=\"SCALE\">major</field>\n                         <field name=\"ROOT\">C</field>\n                         <value name=\"VALUE\">\n                             <block type=\"tecla_software_lfo\">\n                                 <value name=\"RATE\"><shadow type=\"math_number\"><field name=\"NUM\">0.1</field></shadow></value>\n                                 <value name=\"MIN\"><shadow type=\"math_number\"><field name=\"NUM\">48</field></shadow></value>\n                                 <value name=\"MAX\"><shadow type=\"math_number\"><field name=\"NUM\">84</field></shadow></value>\n                             </block>\n                         </value>\n                     </block>\n                 </value>\n                 <value name=\"VELOCITY\"><shadow type=\"math_number\"><field name=\"NUM\">90</field></shadow></value>\n                 <value name=\"DURATION\"><shadow type=\"math_number\"><field name=\"NUM\">0.2</field></shadow></value>\n             </block>\n         </statement>\n      </block>\n    </statement>\n  </block>\n</xml>"
}
