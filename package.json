{
  "name": "tecla-blocks",
  "version": "1.0.0",
  "description": "App educativa per programar TECLA amb blocs visuals",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build-mac": "electron-builder --mac",
    "build-win": "electron-builder --win",
    "build-linux": "electron-builder --linux"
  },
  "build": {
    "appId": "org.tecla.blocks",
    "productName": "TECLA Blocks",
    "mac": {
      "category": "public.app-category.education",
      "icon": "assets/icon.icns",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icon.png",
      "category": "Education"
    }
  },
  "keywords": [
    "education",
    "music",
    "programming",
    "blocks",
    "scratch",
    "midi"
  ],
  "author": "TECLA Project",
  "license": "MIT",
  "dependencies": {
    "blockly": "^10.4.0",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  }
}
